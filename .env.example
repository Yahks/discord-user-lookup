# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional bot token from @BotFather to enable Telegram bot & Mini App integration.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_MINI_APP_URL: Optional public HTTPS URL for the Telegram Mini App button (overrides APP_URL).
TELEGRAM_MINI_APP_URL=""

# TELEGRAM_ALLOWED_USER_IDS: Optional comma-separated Telegram user IDs allowed to use the bot (leave empty for public access).
TELEGRAM_ALLOWED_USER_IDS=""

# FREE_DAILY_LIMIT: Number of lookups allowed per user per UTC day on the free tier.
FREE_DAILY_LIMIT="50"

# TELEGRAM_REQUIRE_INIT_DATA: Set to "true" to restrict web API access exclusively to verified Telegram Mini App sessions.
TELEGRAM_REQUIRE_INIT_DATA="false"

# TELEGRAM_ADMIN_USER_IDS: Comma-separated Telegram user IDs permitted to view all user tracking logs and receive admin alerts.
TELEGRAM_ADMIN_USER_IDS=""

# TELEGRAM_ADMIN_ALERTS: Set to "false" to mute live Telegram notifications to admins for user sign-ins, lookups, and blocks.
TELEGRAM_ADMIN_ALERTS="true"

